{
  "name": "agendev",
  "version": 2,
  "managedBy": "CDK",
  "runtimes": [
    {
      "name": "agendev",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/agendev",
      "runtimeVersion": "PYTHON_3_14",
      "protocol": "HTTP"
    },
    {
      "name": "financetools",
      "description": "Finance tools as an MCP server",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/financetools",
      "runtimeVersion": "PYTHON_3_14",
      "protocol": "MCP"
    }
  ],
  "memories": [
    {
      "name": "chat",
      "description": "Chat history and long-term user facts",
      "eventExpiryDuration": 30,
      "strategies": [
        {
          "type": "SEMANTIC",
          "namespaceTemplates": [
            "/users/{actorId}/facts"
          ]
        },
        {
          "type": "USER_PREFERENCE",
          "namespaceTemplates": [
            "/users/{actorId}/preferences"
          ]
        }
      ]
    }
  ],
  "knowledgeBases": [],
  "credentials": [
    {
      "authorizerType": "ApiKeyCredentialProvider",
      "name": "alpha-vantage",
      "secretRef": {
        "secretId": "arn:aws:secretsmanager:ap-south-1:223956247301:secret:agentoprod/alpha-vantage-LkFNFc",
        "jsonKey": "api_key"
      }
    }
  ],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "tools",
      "protocolType": "None",
      "description": "IAM front door for the finance MCP runtime",
      "targets": [
        {
          "name": "finance",
          "targetType": "httpRuntime",
          "httpRuntime": {
            "runtime": "financetools"
          }
        }
      ],
      "authorizerType": "AWS_IAM",
      "enableSemanticSearch": false,
      "exceptionLevel": "NONE"
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "harnesses": []
}